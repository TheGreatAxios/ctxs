# Deployment & Script Configuration
# Use --account <name> flag with foundry commands instead of PRIVATE_KEY

# Example deployment:
# forge script script/Deploy.s.sol --rpc-url <url> --account <name> --broadcast

# Contract Addresses (after deployment - for reference)
SCHEDULER_ADDRESS=0x...
FACTORY_ADDRESS=0x...
ROUTER_ADDRESS=0x...

# Token Addresses
USDC_ADDRESS=0x...
USDT_ADDRESS=0x...
WETH_ADDRESS=0x...
WBTC_ADDRESS=0x...

# Pool Addresses
POOL_USDC_WETH=0x...
POOL_USDC_WBTC=0x...
POOL_USDT_WETH=0x...
POOL_USDT_WBTC=0x...
POOL_WETH_WBTC=0x...

# Example: Submit a scheduled swap
# forge script script/SubmitScheduledSwap.s.sol \
#   --sig "run(address,address,address,uint256,uint256,bool,uint256)" \
#   --rpc-url <url> \
#   --account <name> \
#   --broadcast \
#   <SCHEDULER_ADDRESS> <POOL_ADDRESS> <TOKEN_IN> <AMOUNT> <TARGET_PRICE> <DIRECTION> <DEADLINE>

# Example: Set price for a pool
# forge script script/SetPrice.s.sol \
#   --sig "run(address,address,uint256)" \
#   --rpc-url <url> \
#   --account <name> \
#   --broadcast \
#   <SCHEDULER_ADDRESS> <POOL_ADDRESS> <PRICE>

# Example: Check swaps
# forge script script/CheckSwaps.s.sol \
#   --sig "run(address,address)" \
#   --rpc-url <url> \
#   --account <name> \
#   --broadcast \
#   <SCHEDULER_ADDRESS> <POOL_ADDRESS>

# RPC URL (for SKALE testnet)
RPC_URL=https://testnet-v3.calypso.skale.network
